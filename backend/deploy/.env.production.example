# Do not commit the filled .env.production file.
# Replace api.example.com with a domain you own before deployment.
API_DOMAIN=api.example.com

MYSQL_DATABASE=youju
MYSQL_USER=youju
MYSQL_PASSWORD=replace_with_a_long_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_root_password

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=7d
# Native HarmonyOS requests do not normally carry an Origin header, but the API
# requires an explicit production value. Add web origins here if a web client is introduced.
CORS_ORIGIN=https://api.example.com
BACKEND_PUBLIC_URL=https://api.example.com
UPLOADS_DIR=/app/uploads

# Tencent Cloud COS: production image uploads require all five values.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_CDN_BASE=

# Huawei Account Kit / Push Kit. Leave Push credentials empty only when push is deliberately disabled.
HUAWEI_CLIENT_ID=6917613566723435312
HUAWEI_CLIENT_SECRET=
HUAWEI_REDIRECT_URI=
HUAWEI_PUSH_APP_ID=
HUAWEI_PUSH_APP_SECRET=

ADMIN_USER_IDS=
REPORT_THRESHOLD=3
PRIVACY_POLICY_VERSION=1.0.0
