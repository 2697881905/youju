# ===== BigBlueBook 生产环境变量模板 =====
# 复制为 .env 后填入真实值： cp env.prod.example .env
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库。

# 运行模式（必须 production，否则后端以开发态启动并跳过安全闸口）
NODE_ENV=production
PORT=3000

# 数据库：host 用 compose 服务名 "mysql"，不是 localhost
DATABASE_URL=mysql://bigbluebook:请改成强密码@mysql:3306/bigbluebook

# MySQL 容器初始化（同时用于 compose 变量替换；密码必须与上面 DATABASE_URL 一致）
MYSQL_ROOT_PASSWORD=请改成另一个强密码
MYSQL_PASSWORD=请改成强密码（与 DATABASE_URL 一致）

# JWT（生产缺失会直接拒绝启动）
JWT_SECRET=请改成一段足够长的随机串（例如：openssl rand -hex 32）
JWT_EXPIRES_IN=7d

# CORS 允许的源（生产缺失会直接拒绝启动）。
# 原生鸿蒙 App 一般填 API 域名即可；若请求被 CORS 拦截，可临时设为 * 排查，但生产不建议长期放开。
CORS_ORIGIN=https://api.mindtype.cn

# 后端对外公开地址（生产必须以 https 开头，否则启动即崩溃）
BACKEND_PUBLIC_URL=https://api.mindtype.cn

# 腾讯云 COS（图片直传，必填；仓库现有 .env 已填真实值，复制时一并带入）
COS_SECRET_ID=请填真实 SecretId
COS_SECRET_KEY=请填真实 SecretKey
COS_BUCKET=bigbluebook-1440002925
COS_REGION=ap-guangzhou
COS_CDN_BASE=

# 华为账号登录（Account Kit）
# CLIENT_ID 必须与 entry/src/main/module.json5 的 metadata.client_id 完全一致
HUAWEI_CLIENT_ID=6917611781679753920
HUAWEI_CLIENT_SECRET=请填 AGC 应用 OAuth 客户端密钥
HUAWEI_REDIRECT_URI=

# 内容审核 & 举报
# 管理员 userId（逗号分隔），生产务必改为真实管理员账号 id，禁止用 1 之类的默认值
ADMIN_USER_IDS=
REPORT_THRESHOLD=3

# 隐私政策版本（前端弹窗同意时上报；低于此版本视为需重新征求）
PRIVACY_POLICY_VERSION=1.0.0

# 华为推送服务 Push Kit（可选，留空则推送静默降级）
# HUAWEI_PUSH_APP_ID=
# HUAWEI_PUSH_APP_SECRET=
