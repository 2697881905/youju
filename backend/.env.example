# 后端环境变量模板
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会提交到仓库
PORT=3000

# 数据库（本机 MySQL 示例）
DATABASE_URL=mysql://youju:your_db_password@localhost:3306/youju

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# 腾讯云 COS（图片直传，必填后图片上传才可用）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_CDN_BASE=

# 华为账号登录（Account Kit / 获取 UnionID）
# 前端 module.json5 的 client_id 已配置为 6917611781679753920，本处 CLIENT_ID 必须与之完全一致
# CLIENT_SECRET = AGC 应用「应用信息 / OAuth2.0 客户端」里的 App Secret（OAuth 客户端密钥）
# REDIRECT_URI  = 通常留空即可；仅当 AGC 要求回填回调地址时再填
HUAWEI_CLIENT_ID=6917613566723435312
HUAWEI_CLIENT_SECRET=
HUAWEI_REDIRECT_URI=

# 内容审核 & 举报系统
# 审核员 userId（逗号分隔），adminAuth 中间件校验 req.userId 是否在此列表
# 审核员 userId（逗号分隔）。生产环境务必改为真实管理员账号的 id，禁止使用 1 之类的自增默认值。留空则无管理员。
ADMIN_USER_IDS=
# 举报自动下架阈值（被举报达此次数自动 status=0 进入待审核队列）
REPORT_THRESHOLD=3
